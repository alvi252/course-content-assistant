# Copy to .env and fill in. Never commit .env.

# --- Providers -----------------------------------------------------------------
OPENAI_API_KEY=
# LLM_PROVIDER=openai            # openai | anthropic
# LLM_MODEL=gpt-4.1-mini         # or gpt-4o-mini; for anthropic e.g. claude-haiku-5-5
# ANTHROPIC_API_KEY=             # only when LLM_PROVIDER=anthropic
# EMBEDDING_PROVIDER=openai      # openai | hashing (offline, lexical, for demos/tests)
# EMBEDDING_MODEL=text-embedding-3-small
# REQUEST_TIMEOUT_S=60           # a 15-idea request took up to ~16 s live; 30 ideas ~30 s

# --- Author and material -------------------------------------------------------
# AUTHOR_NAME=Mira Calder
# LIBRARY_DIR=data/library       # <course>/<lesson>.md and webinars/<name>.md
# VOICE_DIR=data/voice           # style.md and samples/*.md
# INDEX_PATH=data/index.sqlite   # search index AND the log of ideas (back it up)
# CHUNK_MAX_CHARS=1200
# CHUNK_OVERLAP_CHARS=200

# --- Ideas ---------------------------------------------------------------------
# IDEAS_DEFAULT_COUNT=15
# IDEAS_MAX_COUNT=30
# IDEAS_PER_LESSON=2             # most passages taken from one lesson per request
# MIN_PASSAGE_CHARS=200          # shorter passages are skipped
# SKIP_USED_DAYS=30              # passages used in the last N days are skipped; 0 = never skip
# IDEAS_TEMPERATURE=0.7
# IDEAS_TOKENS_PER_IDEA=250      # output budget per request: 400 + this x passages sent
# IDEAS_SEED=                    # a number makes tie-breaks in the selection repeatable

# --- Scripts -------------------------------------------------------------------
# SCRIPT_TEMPERATURE=0.6
# SCRIPT_MAX_TOKENS=900

# --- Search (used when you ask for ideas about a topic) -------------------------
# TOP_K=5
# MIN_SIMILARITY=0.30            # passages less similar than this are ignored
# HYBRID_SEARCH=true             # vector + BM25 with reciprocal rank fusion

# --- Operations ----------------------------------------------------------------
# ADMIN_TOKEN=                   # if set, POST /ingest requires header X-Admin-Token
# USAGE_LOG_PATH=                # JSONL log of token usage per paid call (no prompts, no keys)
